    { "id": "q15", "kind": "exact", "must": false, "query": "Database.serialize", "library": "bun", "version": "1.4.3",
      "expect": [{ "source": "bun@1.4.3", "document": "sqlite.mdx", "heading": ".serialize()", "contains": "serialize" }] },
    { "id": "q16", "kind": "paraphrase", "must": false, "query": "bind named parameters without writing the $ prefix", "library": "bun", "version": "1.4.3",
      "expect": [{ "source": "bun@1.4.3", "document": "sqlite.mdx", "heading": "strict: true lets you bind values without prefixes", "contains": "strict" }] },
    { "id": "q17", "kind": "relationship", "must": false, "query": "which Bun API for password storage versus a SHA-256 checksum", "library": "bun", "version": "1.4.3",
      "expect": [
        { "source": "bun@1.4.3", "document": "hashing.mdx", "heading": "Bun.password", "contains": "Bun.password" },
        { "source": "bun@1.4.3", "document": "hashing.mdx", "heading": "Bun.CryptoHasher", "contains": "sha256" }
      ] },
    { "id": "q18", "kind": "version", "must": true, "query": "bcrypt cost option for Bun.password.hash", "library": "bun", "version": "1.2.0",
      "expect": [{ "source": "bun@1.2.0", "document": "hashing.md", "heading": "Bun.password", "contains": "cost" }] },
    { "id": "q19", "kind": "version", "must": true, "query": "remove WAL sidecar files after close", "library": "bun", "version": "1.2.0",
      "note": "1.2.0 has no sidecar cleanup section; any hit must be 1.2.0 and the 1.4.3 passage must never appear",
      "expect": [], "expectStatus": ["ok", "weak_match", "no_match"] },
    { "id": "q20", "kind": "version", "must": false, "query": "close(throwOnError) behaviour", "library": "bun", "version": "1.2.0",
      "expect": [{ "source": "bun@1.2.0", "document": "sqlite.md", "heading": ".close(throwOnError: boolean = false)", "contains": "close" }] },
    { "id": "q21", "kind": "exact", "must": true, "query": "hashlib.pbkdf2_hmac", "library": "python", "version": "3.13",
      "expect": [{ "source": "python@3.13", "document": "hashlib.html", "heading": "Key derivation", "contains": "pbkdf2_hmac" }] },
    { "id": "q22", "kind": "code+warning", "must": true, "query": "which hash algorithms have known collision weaknesses", "library": "python", "version": "3.13",
      "expect": [{ "source": "python@3.13", "document": "hashlib.html", "heading": "Hash algorithms", "contains": "collision" }] },
    { "id": "q23", "kind": "paraphrase", "must": false, "query": "hash a big file without reading it all into memory", "library": "python", "version": "3.13",
      "expect": [{ "source": "python@3.13", "document": "hashlib.html", "heading": "File hashing", "contains": "file_digest" }] },
    { "id": "q24", "kind": "exact", "must": false, "query": "blake2b digest_size", "library": "python", "version": "3.13",
      "expect": [{ "source": "python@3.13", "document": "hashlib.html", "heading": "Using different digest sizes", "contains": "digest_size" }] },
    { "id": "q25", "kind": "relationship", "must": false, "query": "password hashing in Bun compared with key derivation in Python hashlib",
      "expect": [
        { "source": ["bun@1.4.3", "bun@1.2.0"], "document": ["hashing.mdx", "hashing.md"], "heading": "Bun.password", "contains": "Bun.password" },
        { "source": "python@3.13", "document": "hashlib.html", "heading": "Key derivation", "contains": "pbkdf2" }
      ], "versionAllowed": ["bun@1.4.3", "bun@1.2.0", "python@3.13"] },
    { "id": "q26", "kind": "absent", "must": true, "query": "How do I configure Kubernetes ingress TLS certificates?", "expect": [], "expectStatus": ["no_match", "weak_match"],
