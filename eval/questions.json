{
  "reviewed": "2026-10-21, against fixtures/corpus before any mode was scored. After the baseline run, weak_match was added as a status and accepted for q26 and for found evidence; see docs/evaluation.md",
  "budget": 1500,
  "targets": {
    "mustPassCombined": "all must-pass questions pass in combined mode",
    "recallCombined": 0.8,
    "maxTokens": "every result tokens <= budget",
    "citationValidity": 1.0,
    "versionLeaks": 0,
    "p95LatencyMs": 150,
    "latencyNote": "warm process on Apple M4 Pro 48 GB, embedding model already loaded"
  },
  "questions": [
    { "id": "q01", "kind": "exact", "must": true, "query": "Database.fileControl", "library": "bun", "version": "1.4.3",
      "expect": [{ "source": "bun@1.4.3", "document": "sqlite.mdx", "heading": ".fileControl(cmd: number, value: any)", "contains": "sqlite3_file_control" }] },
    { "id": "q02", "kind": "exact", "must": true, "query": "SQLITE_FCNTL_PERSIST_WAL", "library": "bun", "version": "1.4.3",
      "expect": [{ "source": "bun@1.4.3", "document": "sqlite.mdx", "heading": "WAL sidecar file cleanup", "contains": "SQLITE_FCNTL_PERSIST_WAL" }] },
    { "id": "q03", "kind": "paraphrase", "must": true, "query": "stop the -wal and -shm files from lingering on macOS after I close the db", "library": "bun", "version": "1.4.3",
      "expect": [{ "source": "bun@1.4.3", "document": "sqlite.mdx", "heading": "WAL sidecar file cleanup", "contains": "persistent WAL" }] },
    { "id": "q04", "kind": "paraphrase", "must": true, "query": "store a user's login secret so it can be checked later without keeping plaintext", "library": "bun", "version": "1.4.3",
      "expect": [{ "source": "bun@1.4.3", "document": "hashing.mdx", "heading": "Bun.password", "contains": "Bun.password.hash" }] },
    { "id": "q05", "kind": "paraphrase", "must": false, "query": "quick non-cryptographic checksum of a string", "library": "bun", "version": "1.4.3",
      "expect": [{ "source": "bun@1.4.3", "document": "hashing.mdx", "heading": "Bun.hash", "contains": "Bun.hash" }] },
    { "id": "q06", "kind": "paraphrase", "must": true, "query": "apply several inserts all-or-nothing and undo them if one throws", "library": "bun", "version": "1.4.3",
      "expect": [{ "source": "bun@1.4.3", "document": "sqlite.mdx", "heading": "Transactions", "contains": "db.transaction" }] },
    { "id": "q07", "kind": "paraphrase", "must": false, "query": "read result rows lazily one by one instead of loading them all", "library": "bun", "version": "1.4.3",
      "expect": [{ "source": "bun@1.4.3", "document": "sqlite.mdx", "heading": ".iterate() (@@iterator)", "contains": "iterate" }] },
    { "id": "q08", "kind": "paraphrase", "must": true, "query": "very large 64-bit numbers come back from queries with wrong digits", "library": "bun", "version": "1.4.3",
      "expect": [{ "source": "bun@1.4.3", "document": "sqlite.mdx", "heading": "safeIntegers: true", "contains": "bigint" }] },
    { "id": "q09", "kind": "paraphrase", "must": false, "query": "turn query results into instances of my own class", "library": "bun", "version": "1.4.3",
      "expect": [{ "source": "bun@1.4.3", "document": "sqlite.mdx", "heading": ".as(Class) - Map query results to a class", "contains": ".as(" }] },
    { "id": "q10", "kind": "exact", "must": false, "query": "HMAC with Bun.CryptoHasher", "library": "bun", "version": "1.4.3",
      "expect": [{ "source": "bun@1.4.3", "document": "hashing.mdx", "heading": "HMAC in Bun.CryptoHasher", "contains": "hmac" }] },
    { "id": "q11", "kind": "relationship", "must": true, "query": "what happens to prepared statements when the database is closed, and when is the file handle released", "library": "bun", "version": "1.4.3",
