    { "id": "q12", "kind": "relationship", "must": true, "query": "which algorithms can Bun.password use and what string formats do their hashes use", "library": "bun", "version": "1.4.3",
      "expect": [
        { "source": "bun@1.4.3", "document": "hashing.mdx", "heading": "bcrypt - Modular Crypt Format", "contains": "Modular Crypt Format" },
        { "source": "bun@1.4.3", "document": "hashing.mdx", "heading": "argon2 - PHC format", "contains": "PHC" }
      ] },
    { "id": "q13", "kind": "code+warning", "must": true, "query": "is it a bug that the sidecar files stay after close on macOS", "library": "bun", "version": "1.4.3",
