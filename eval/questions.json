    { "id": "q27", "kind": "absent", "must": true, "query": "pipeline multiple commands with Bun.redis", "library": "bun", "version": "1.4.3", "expect": [], "expectStatus": ["no_match"] },
    { "id": "q28", "kind": "version", "must": true, "query": "Bun.password", "library": "bun", "version": "9.9", "expect": [], "expectStatus": ["version_unavailable"] }
