# Copy to .env and uncomment what you need. .env is gitignored.
#
# Bun loads .env from the current directory, so this file applies to commands run from the
# checkout root: bun src/cli.ts, bun test, make serve. A linked `docify` run from elsewhere,
# an MCP server started by an agent and the macOS app do not read it; set the variables in
# their own environment.
#
# Keep unused lines commented out. `NAME=` with no value sets NAME to an empty string, and an
# empty string replaces the default instead of falling back to it.

# ---- Docify ------------------------------------------------------------------

# Store location. Default: ~/.cache/docify
# DOCIFY_HOME=/absolute/path/to/store

# Embedding model cache for the in-process model; `docify setup` downloads into it.
# Default: <store>/models. modelsDir in config.json wins over this.
# DOCIFY_MODELS_DIR=/absolute/path/to/models

# Graphify executable run during prepare.
# Default: <store>/graphify-venv/bin/graphify. graphifyBin in config.json wins over this.
# DOCIFY_GRAPHIFY_BIN=/absolute/path/to/graphify

# Ollama server for "embeddingProvider": "ollama". embeddingUrl in config.json wins over this.
# Default: http://localhost:11434, where docker-compose.yml starts one.
# DOCIFY_EMBED_URL=http://localhost:11434

# Project whose .docify.json pins apply in CLI search and MCP.
# Default: the current directory. The MCP server tries CLAUDE_PROJECT_DIR before that.
# DOCIFY_PROJECT=/absolute/path/to/project

# ---- LLM proxy (LiteLLM or any OpenAI-compatible server) -------------------------

# Used by graph extraction and by "embeddingProvider": "openai". config.json holds only these
# names, never the values; graph.baseUrlEnv, graph.apiKeyEnv, embeddingBaseUrlEnv and
# embeddingApiKeyEnv point Docify at other variables.
# Give the base URL without /v1. The graph provider always appends it.
# LITELLM_BASE_URL=https://litellm.example.com
# LITELLM_API_KEY=your-key

# Read instead of the two above when config.json sets a graph provider without
# baseUrlEnv and apiKeyEnv.
# OPENAI_BASE_URL=https://api.example.com/v1
# OPENAI_API_KEY=your-key

# Not read from here: DOCIFY_BIN, the docify executable the macOS app runs. It comes from the
# app's environment; `make app-run` points it at this checkout.
