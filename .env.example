# Copy to .env and uncomment what you need. .env is gitignored.
#
# Bun loads .env from the current directory, so this file applies to commands run from the
# checkout root: bun src/cli.ts, bun test, make serve. A linked `docify` run from elsewhere
# and an MCP server started by an agent do not read it; set the variables in their own
# environment.
#
# Keep unused lines commented out. `NAME=` with no value sets NAME to an empty string, and an
# empty string replaces the default instead of falling back to it.

# ---- Docify ------------------------------------------------------------------

# Store location. Default: ~/.cache/docify
# DOCIFY_HOME=/absolute/path/to/store

# Embedding model cache for the in-process model; `docify setup` downloads into it.
# Default: <store>/models. modelsDir in config.json wins over this.
# DOCIFY_MODELS_DIR=/absolute/path/to/models

# Graphify executable run during prepare.
# Default: <store>/graphify-venv/bin/graphify. graphifyBin in config.json wins over this.
# DOCIFY_GRAPHIFY_BIN=/absolute/path/to/graphify

# Ollama server for "embeddingProvider": "ollama". embeddingUrl in config.json wins over this.
# Default: http://localhost:11434, where docker-compose.yml starts one.
# DOCIFY_EMBED_URL=http://localhost:11434

# Host directory for the Ollama models in docker-compose.yml. Default: ./data/ollama.
# OLLAMA_DATA_DIR=/absolute/path/to/ollama

# Project whose .docify.json pins apply in CLI search and MCP.
# Default: the current directory. The MCP server tries CLAUDE_PROJECT_DIR before that.
# DOCIFY_PROJECT=/absolute/path/to/project

# ---- LLM proxy (LiteLLM or any OpenAI-compatible server) -------------------------

# Used by graph extraction and by "embeddingProvider": "openai". config.json holds only these
# names, never the values; graph.baseUrlEnv, graph.apiKeyEnv, embeddingBaseUrlEnv and
# embeddingApiKeyEnv point Docify at other variables.
# Give the base URL without /v1. The graph provider always appends it.
# LITELLM_BASE_URL=https://litellm.example.com
# LITELLM_API_KEY=your-key

# Read instead of the two above when config.json sets a graph provider without
# baseUrlEnv and apiKeyEnv.
# OPENAI_BASE_URL=https://api.example.com/v1
# OPENAI_API_KEY=your-key

# ---- Hosted deployment (docker-compose.prod.yml, Coolify) ------------------------

# Optional web access token, at least 16 characters. Generate one with `openssl rand -hex 32`.
# Without it the web UI and /api need no token: anyone who can reach the port can use them.
# DOCIFY_WEB_TOKEN=

# User accounts: people sign in with GitHub instead of the shared token (do not set both).
# Create a GitHub OAuth app with the callback URL <public address>/auth/github/callback and
# put its client id and secret here. Both or neither.
# DOCIFY_GITHUB_CLIENT_ID=
# DOCIFY_GITHUB_CLIENT_SECRET=

# Administrators, by GitHub login or id:<number>, comma separated. Required with accounts.
# A login is tied to the first GitHub account that signs in with it, so sign in before sharing
# the address. Everyone else waits for an administrator's approval, unless the access list
# under Users (organizations, logins, email addresses) lets them in.
# DOCIFY_ADMINS=your-login

# Public address of the UI, scheme and host only. Required with accounts unless the server
# listens on loopback only (so always in Docker). With https the session cookie is Secure.
# DOCIFY_PUBLIC_URL=https://docify.example.com

# Optional. Hostnames the UI accepts, comma separated. Unset: loopback only on 127.0.0.1,
# any Host when bound to 0.0.0.0 (a warning is logged). Use the public domain when behind a
# proxy; a bare hostname matches any port. "*" accepts any Host (not recommended).
# DOCIFY_ALLOWED_HOSTS=docify.example.com

# Address `docify serve` binds to. Default: 127.0.0.1. The image sets 0.0.0.0.
# DOCIFY_HOST=127.0.0.1

# Host directory for the store in docker-compose.prod.yml (bind-mounted at /data).
# Default: /data/docify, owned by uid 10001 with mode 0750. On Docker Desktop (macOS) use a
# path Docker can share, for example ./data/docify.
# DOCIFY_DATA_DIR=./data/docify

# Host-side publishing in docker-compose.prod.yml. Keep loopback when a reverse proxy is in front.
# DOCIFY_BIND=127.0.0.1
# DOCIFY_HOST_PORT=4747

# Host directory mounted read-only at /sources in docker-compose.prod.yml. Default: /srv/docify/sources.
DOCIFY_SOURCES_DIR=~/Development

# Where the web UI may register local sources, a path list. Default: the home directory.
# DOCIFY_SOURCE_ROOTS=/sources

# MCP over HTTP at /mcp, one name:token pair per agent, tokens 16+ characters. With user accounts
# people make their own keys in the web UI and this is only for agents that belong to nobody.
# Without accounts, unset keeps /mcp off.
# DOCIFY_MCP_TOKENS=claude:<token>,openclaw-1:<token>

# MCP rate limits per client and per IP. Units: s, min, h.
# DOCIFY_MCP_RATE=60/min
# DOCIFY_MCP_IP_RATE=120/min

# 1 takes the client IP from the last X-Forwarded-For entry. Only behind a reverse proxy.
# DOCIFY_TRUST_PROXY=1
