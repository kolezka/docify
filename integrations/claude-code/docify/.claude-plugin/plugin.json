{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "docify",
  "version": "0.1.1",
  "description": "Search locally prepared documentation with cited, token-bounded excerpts. Queries run offline.",
  "license": "UNLICENSED",
  "keywords": [
    "documentation",
    "retrieval",
    "mcp"
  ],
  "mcpServers": {
    "docify": {
      "command": "docify",
      "args": [
        "mcp",
        "--require",
        "0.1.0"
      ]
    }
  },
  "author": {
    "name": "Docify"
  }
}
