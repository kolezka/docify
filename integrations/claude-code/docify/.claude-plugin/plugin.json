{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "docify",
  "version": "0.2.0",
  "description": "Search documentation prepared by a Docify service, with cited, token-bounded excerpts.",
  "license": "UNLICENSED",
  "keywords": [
    "documentation",
    "retrieval",
    "mcp"
  ],
  "mcpServers": {
    "docify": {
      "type": "http",
      "url": "${DOCIFY_MCP_URL:-http://127.0.0.1:4747/mcp}",
      "headers": {
        "Authorization": "Bearer ${DOCIFY_MCP_TOKEN}"
      }
    }
  },
  "author": {
    "name": "Docify"
  }
}
